        };

        boolean[] used =
                new boolean[4];

        int matching = 0;

        for (int i = 0; i < 4; i++) {

            for (int j = 0; j < 4; j++) {

                if (
                        graph[i][j] == 1
                        &&
                        !used[j]) {

                    used[j] = true;
                    matching++;

                    break;
                }
            }
        }

        System.out.println(
                "\nBipartite Matching");

        System.out.println(
                "Maximum Matching : "
                        + matching);
    }

