    // ============================================================
    // KMP
    // ============================================================

    static boolean kmp(String text, String pattern) {

        int[] lps = new int[pattern.length()];

        int len = 0;
        int i = 1;

        while (i < pattern.length()) {

            if (pattern.charAt(i) == pattern.charAt(len)) {

                len++;
                lps[i] = len;
                i++;

            } else {

                if (len != 0) {
                    len = lps[len - 1];
                } else {
                    lps[i] = 0;
                    i++;
                }
            }
        }

        i = 0;
        int j = 0;

        while (i < text.length()) {

            if (text.charAt(i) == pattern.charAt(j)) {

                i++;
                j++;

                if (j == pattern.length()) {
                    return true;
                }

            } else {

                if (j != 0) {
                    j = lps[j - 1];
                } else {
                    i++;
                }
            }
        }

        return false;
    }

    static void runKMP(String word) {

        System.out.println("\n========== KMP SEARCH ==========");

        int count = 0;

        for (int i = 0; i < records.length; i++) {

            if (kmp(
                    records[i].toLowerCase(),
                    word.toLowerCase())) {

                System.out.println(
                        "Record " + (i + 1) +
                        " : " + records[i]);

                count++;
            }
        }

        System.out.println(
                "\nTotal Matching Records : " + count);
    }

    // ============================================================
    // Z FUNCTION
    // ============================================================

    static boolean zSearch(String text, String pattern) {

        String s =
                pattern.toLowerCase()
                + "$"
                + text.toLowerCase();

        int[] z = new int[s.length()];

        int left = 0;
        int right = 0;

        for (int i = 1; i < s.length(); i++) {

            if (i <= right) {
                z[i] =
                        Math.min(
                                right - i + 1,
                                z[i - left]);
            }

            while (
                    i + z[i] < s.length()
                    &&
                    s.charAt(z[i])
                    ==
                    s.charAt(i + z[i])) {

                z[i]++;
            }

            if (i + z[i] - 1 > right) {

                left = i;
                right = i + z[i] - 1;
            }

            if (z[i] == pattern.length()) {
                return true;
            }
        }

        return false;
    }

    static void runZ(String word) {

        System.out.println("\n========== Z-FUNCTION SEARCH ==========");

