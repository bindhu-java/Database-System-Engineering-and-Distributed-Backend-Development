            return;
        }

        int n =
                Math.min(list.size(), 10);

        int[] values =
                new int[n];

        System.out.println(
                "\nValues generated from matching records:");

        for (int i = 0; i < n; i++) {

            int index = list.get(i);

            values[i] =
                    records[index].split("\\s+").length;

            System.out.println(
                    "Record " + (index + 1) +
                    " -> " + values[i]);
        }

        System.out.print(
                "\nEnter target sum: ");

        int target =
                Integer.parseInt(sc.nextLine());

        boolean[] dp =
                new boolean[target + 1];

        dp[0] = true;

        for (int value : values) {

            for (int j = target;
                 j >= value;
                 j--) {

                dp[j] =
                        dp[j]
                        ||
                        dp[j - value];
            }
        }

        if (dp[target]) {

            System.out.println(
                    "Subset EXISTS for target "
                            + target);

        } else {

            System.out.println(
                    "Subset DOES NOT EXIST for target "
                            + target);
        }
    }

    // ============================================================
    // INTERVAL DP
    // ============================================================

    static void runIntervalDP(String word) {

        ArrayList<Integer> list =
                keywordSearch(word);

        if (list.isEmpty()) {
            return;
        }

        int n =
                Math.min(list.size(), 5);

        int[] p =
                new int[n + 1];

        p[0] = 10;

        for (int i = 1; i <= n; i++) {

            p[i] =
                    records[list.get(i - 1)]
                            .split("\\s+").length + 5;
        }

        int[][] dp =
                new int[n + 1][n + 1];

        for (int length = 2;
             length <= n;
             length++) {

            for (int i = 1;
                 i <= n - length + 1;
                 i++) {

                int j =
                        i + length - 1;

                dp[i][j] =
                        Integer.MAX_VALUE;

                for (int k = i;
                     k < j;
                     k++) {

                    int cost =
                            dp[i][k]
                            + dp[k + 1][j]
                            + p[i - 1]
                            * p[k]
                            * p[j];

                    dp[i][j] =
                            Math.min(
                                    dp[i][j],
                                    cost);
                }
            }
        }

        System.out.println(
                "\nInterval DP Minimum Cost : "
                        + dp[1][n]);
    }

    // ============================================================
    // BITMASK DP
    // ============================================================

    static void runBitmaskDP(String word) {

        ArrayList<Integer> list =
                keywordSearch(word);

        if (list.isEmpty()) {
            return;
        }

        int n =
                Math.min(list.size(), 4);

        int[][] cost =
                new int[n][n];

        for (int i = 0; i < n; i++) {

            int value =
                    records[list.get(i)]
                            .split("\\s+").length;

            for (int j = 0; j < n; j++) {

                cost[i][j] =
                        Math.abs(
                                value - (j + 5));
            }
        }

        int total =
                1 << n;

        int[] dp =
                new int[total];

        Arrays.fill(
                dp,
                Integer.MAX_VALUE);

        dp[0] = 0;

        for (int mask = 0;
             mask < total;
             mask++) {

            int person =
                    Integer.bitCount(mask);

            if (person >= n) {
                continue;
            }

            if (dp[mask]
                    == Integer.MAX_VALUE) {
                continue;
            }

            for (int job = 0;
                 job < n;
                 job++) {

                if (
                        (mask & (1 << job))
                                == 0) {

                    int next =
                            mask | (1 << job);

                    dp[next] =
                            Math.min(
                                    dp[next],
                                    dp[mask]
                                            + cost[person][job]);
                }
            }
        }

        System.out.println(
                "\nBitmask DP Minimum Assignment Cost : "
                        + dp[total - 1]);
    }

    // ============================================================
    // MAX FLOW
    // ============================================================

    static int maxFlow(
            int[][] graph,
            int source,
            int sink) {

        int n = graph.length;

        int[][] residual =
                new int[n][n];

        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                residual[i][j] =
                        graph[i][j];
            }
        }

        int flow = 0;

        while (true) {

            int[] parent =
                    new int[n];

            Arrays.fill(
                    parent,
                    -1);

            Queue<Integer> queue =
                    new LinkedList<>();

            queue.add(source);

            parent[source] =
                    source;

            while (!queue.isEmpty()) {

                int u =
                        queue.poll();

                for (int v = 0;
                     v < n;
                     v++) {

                    if (
                            parent[v] == -1
                            &&
                            residual[u][v] > 0) {

                        parent[v] = u;

                        queue.add(v);
                    }
                }
            }

            if (parent[sink] == -1) {
                break;
            }

            int pathFlow =
                    Integer.MAX_VALUE;

            for (
                    int v = sink;
                    v != source;
                    v = parent[v]) {

                int u =
                        parent[v];

                pathFlow =
                        Math.min(
                                pathFlow,
                                residual[u][v]);
            }

            for (
                    int v = sink;
                    v != source;
                    v = parent[v]) {

                int u =
                        parent[v];

                residual[u][v]
                        -= pathFlow;

                residual[v][u]
                        += pathFlow;
            }

            flow += pathFlow;
        }

        return flow;
    }

