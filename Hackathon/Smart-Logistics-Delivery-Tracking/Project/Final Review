    // =========================================================
    // 2. NAIVE STRING SEARCH
    // =========================================================

    static boolean naiveSearch(
            String text,
            String pattern) {

        if (pattern.length() == 0) {
            return true;
        }

        if (pattern.length() > text.length()) {
            return false;
        }

        for (int i = 0;
             i <= text.length() - pattern.length();
             i++) {

            int j = 0;

            while (j < pattern.length()
                    && text.charAt(i + j)
                    == pattern.charAt(j)) {

                j++;
            }

            if (j == pattern.length()) {
                return true;
            }
        }

        return false;
    }

