    // =========================================================
    // RABIN-KARP
    // =========================================================

    static boolean rabinKarpSearch(
            String text,
            String pattern) {

        int n = text.length();
        int m = pattern.length();

        if (m == 0) {
            return true;
        }

        if (m > n) {
            return false;
        }

        int base = 256;

        int prime = 101;

        long patternHash = 0;

        long textHash = 0;

        long power = 1;

        for (int i = 0; i < m - 1; i++) {

            power =
                    (power * base) % prime;
        }

        for (int i = 0; i < m; i++) {

            patternHash =
                    (base * patternHash
                    + pattern.charAt(i))
                    % prime;

            textHash =
                    (base * textHash
                    + text.charAt(i))
                    % prime;
        }

        for (int i = 0; i <= n - m; i++) {

            if (patternHash == textHash) {

                int j = 0;

                while (
                        j < m
                        &&
                        text.charAt(i + j)
                        == pattern.charAt(j)
                ) {

                    j++;
                }

                if (j == m) {

                    return true;
                }
            }

            if (i < n - m) {

                textHash =
                        (
                                base
                                *
                                (
                                        textHash
                                        - text.charAt(i)
                                        * power
                                )
                                + text.charAt(i + m)
                        )
                        % prime;

                if (textHash < 0) {

                    textHash += prime;
                }
            }
        }

        return false;
    }

