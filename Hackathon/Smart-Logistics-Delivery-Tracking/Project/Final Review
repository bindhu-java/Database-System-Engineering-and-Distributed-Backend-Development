    // =========================================================
    // HASH FUNCTION
    // =========================================================

    static long hashFunction(String text) {

        long hash = 0;

        for (int i = 0; i < text.length(); i++) {

            hash =
                    hash * 31
                    + text.charAt(i);
        }

        return hash;
    }

