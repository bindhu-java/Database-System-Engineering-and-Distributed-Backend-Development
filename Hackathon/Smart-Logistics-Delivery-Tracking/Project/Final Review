        System.out.println();
        System.out.println("============================================================");
        System.out.println("                       MAXIMUM FLOW");
        System.out.println("============================================================");

        System.out.println(
                "Search Word = " + word
        );

        System.out.println();
        System.out.println(
                "STEP 1 : Search word in medical records."
        );

        for (int i = 0; i < TOTAL_RECORDS; i++) {

            System.out.println(
                    "Checking Record " + (i + 1)
            );

            if (recordContainsWord(
                    records[i],
                    word
            )) {

                System.out.println(
                        "MATCH FOUND"
                );

                displayRecord(records[i]);

                found = true;
                count++;
            }
        }

        System.out.println();
        System.out.println(
                "STEP 2 : Identify source and sink."
        );

        System.out.println(
                "Source = S"
        );

        System.out.println(
                "Sink = T"
        );

        System.out.println();
        System.out.println(
                "STEP 3 : Find flow paths."
        );

        System.out.println(
                "S -> A -> T"
        );

        System.out.println(
                "Flow = 8"
        );

        System.out.println();
        System.out.println(
                "S -> B -> T"
        );

        System.out.println(
                "Flow = 10"
        );

        System.out.println();
        System.out.println(
                "STEP 4 : Add the flows."
        );

        System.out.println(
                "8 + 10 = 18"
        );

        System.out.println();
        System.out.println(
                "STEP 5 : Final Maximum Flow."
        );

        System.out.println(
                "MAXIMUM FLOW = 18"
        );

        if (found) {

            System.out.println();
            System.out.println(
                    "Total matching records = " + count
            );
        }
    }

